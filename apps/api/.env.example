# ──────────────────────────────────────────────
# Verdant API — Environment Variables Template
# Copy to .env and fill in real values.
# NEVER commit .env to git.
# ──────────────────────────────────────────────

# Server
PORT=8443
NODE_ENV=development

# Frontend origin (for CORS)
FRONTEND_URL=http://localhost:5173

# PostgreSQL
DATABASE_URL=postgresql://verdant:changeme@localhost:5432/verdant

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
# Access token lifetime (e.g. 15m, 1h)
JWT_EXPIRES_IN=15m
# Refresh token lifetime
JWT_REFRESH_EXPIRES_IN=30d

# Razorpay (use test keys locally: https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# 3X-UI panel (fill in after VPS setup — see docs/vps-setup.md)
PANEL_BASE_URL=http://localhost:2087
PANEL_USERNAME=admin
PANEL_PASSWORD=changeme
PANEL_INBOUND_ID=1
